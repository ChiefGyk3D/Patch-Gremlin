#!/bin/bash
# Test stub for curl. Records args + payload to $STUB_CAPTURE_DIR, emits $STUB_HTTP_CODE.
n=$(( $(ls "$STUB_CAPTURE_DIR"/call-* 2>/dev/null | wc -l) + 1 ))
out="$STUB_CAPTURE_DIR/call-$n"
: > "$out"
payload=""
url=""
prev=""
cfg=""
for a in "$@"; do
  case "$prev" in
    -d) payload="$a" ;;
    -K) cfg="$a" ;;
  esac
  case "$a" in
    http*) url="$a" ;;
  esac
  prev="$a"
done
# A -K config file carries the URL and secret headers (never argv).
if [[ -n "$cfg" && -r "$cfg" ]]; then
  cfgurl="$(sed -n 's/^url *= *"\(.*\)"$/\1/p' "$cfg" | head -n1)"
  [[ -n "$cfgurl" ]] && url="$cfgurl"
fi
{
  echo "URL=$url"
  echo "ARGS=$*"
  echo "CMDLINE=$(tr '\0' ' ' < /proc/$$/cmdline 2>/dev/null)"
  if [[ -n "$cfg" && -r "$cfg" ]]; then
    echo "CFGMODE=$(stat -c '%a' "$cfg")"
    # Header lines, unquoted, so tests can grep them as before.
    sed -n 's/^header *= *"\(.*\)"$/\1/p' "$cfg"
  fi
} > "$out"
# payload may be @file
if [[ "$payload" == @* ]]; then
  cp "${payload#@}" "$STUB_CAPTURE_DIR/payload-$n" 2>/dev/null || true
elif [[ -n "$payload" ]]; then
  printf '%s' "$payload" > "$STUB_CAPTURE_DIR/payload-$n"
fi
code="${STUB_HTTP_CODE:-204}"
# Matrix login needs a JSON body back
if [[ "$url" == *"/login"* ]]; then
  printf '{"access_token":"syt_TESTTOKEN","device_id":"TESTDEV"}'
fi
if [[ "$*" == *"-w"* ]]; then printf '\n%s' "$code"; fi
exit 0
